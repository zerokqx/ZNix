{
  "items": [
    {
      "type": "smart_install",
      "label": "Install / Setup ZNix on this Machine",
      "repo_url": "https://github.com/zerokqx/ZNix.git"
    },
    {
      "type": "link",
      "label": "GitHub Profile",
      "url": "https://github.com/zerokqx"
    },
    {
      "type": "link",
      "label": "Portfolio",
      "url": "https://zerokqx-portfolio.vercel.app/"
    },
    {
      "type": "command",
      "label": "Clean Garbage & Optimise (Очистка Nix Store)",
      "target": "nix-collect-garbage -d && nix-store --optimise"
    },
    {
      "type": "link",
      "label": "ZNix Repository",
      "url": "https://github.com/zerokqx/ZNix"
    },
    {
      "type": "command",
      "label": "Update Flake Locks (Обновить зависимости)",
      "target": "nix flake update"
    },
    {
      "type": "nix_run",
      "label": "Run NixVim",
      "target": "git+https://github.com/zerokqx/ZNix#nixvim"
    },
    {
      "type": "command",
      "label": "Clone ZNix Dotfiles",
      "target": "git clone https://github.com/zerokqx/ZNix.git"
    },
    {
      "type": "nix_run",
      "label": "System Specs (Подробный отчет о железе)",
      "target": "nixpkgs#inxi",
      "args": ["-Fz"]
    }
  ]
}
