{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "/run/current-system/sw/bin/playwright-mcp",
        "--executable-path",
        "/etc/profiles/per-user/zerok/bin/chromium",
        "--headless",
        "--isolated"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--executablePath",
        "/etc/profiles/per-user/zerok/bin/chromium",
        "--headless"
      ],
      "enabled": true
    },
    "react-aria": {
      "type": "local",
      "command": ["npx", "@react-aria/mcp@latest"],
      "enabled": true
    }
  }
}
