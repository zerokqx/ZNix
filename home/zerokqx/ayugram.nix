in
{
  options.stylix.targets.ayugram.enable = config.lib.stylix.mkEnableTarget "AyuGram" true;

  config = lib.mkIf (stylix.enable && cfg.enable) {
    # AyuGram stores the selected file path in its own state. Keep that path
    # stable across Home Manager generations instead of writing to that state.
    home.file.".config/ayugram/stylix.tdesktop-theme".source =
      pkgs.runCommand "stylix.tdesktop-theme" { nativeBuildInputs = [ pkgs.zip ]; }
        ''
          cp ${pkgs.writeText "colors.tdesktop-theme" theme} colors.tdesktop-theme
          cp ${pixel "base00"} tiled.png
          zip -q "$out" colors.tdesktop-theme tiled.png
        '';
  };
}
